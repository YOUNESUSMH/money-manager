<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>لوحة التحكم</title>
  <link rel="stylesheet" href="/style.css">
  <style>
  /* صندوق التنبيه الأساسي */
  .crypto-toast {
    position: fixed;
    top: -100px; /* مخفي فوق الشاشة في البداية */
    left: 50%;
    transform: translateX(-50%);
    background-color: #e67e22; /* لون برتقالي تحذيري */
    color: white;
    padding: 15px 25px;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    font-weight: bold;
    z-index: 9999;
    transition: top 0.5s ease-in-out; /* حركة الانزلاق السلسة */
    direction: rtl;
    text-align: right;
  }

  /* الكلاس الذي يظهره عند تفعيله */
  .crypto-toast.show {
    top: 20px; /* ينزل ليتمركز في أعلى الشاشة */
  }
</style>
</head>
<body>
  <h1> رصيدي  👋</h1>
  
  <div class="balance-card-container">
    <h2>الرصيد الحالي (كاش): <span><%= user.balance %> دج</span></h2>
    <h2 class="full-balance-card">الرصيد الكامل (مع السُلف): <span><%= fullBalance %> دج</span></h2>
  </div>

  <div class="stats-container">
    <div class="stat-card expense-stats">📉 إجمالي المصاريف: <span><%= totalExpenses %> دج</span></div>
    <div class="stat-card loan-stats">🤝 سُلف متبقية عند الناس: <span><%= totalLoans %> دج</span></div>
  </div>

  <div class="forms-container">
    <form action="/add-income" method="POST">
      <input type="number" name="amount" placeholder="💰 دخل مالي" required>
      <button type="submit">➕ إضافة رصيد</button>
    </form>

    <form action="/add-loan" method="POST">
      <input type="number" name="amount" placeholder="💸 سُلف (المبلغ)" required>
      <input type="text" name="to" placeholder="👤 إلى من؟" required>
      <button type="submit">➖ تسجيل سُلفة</button>
    </form>

    <form action="/add-expense" method="POST" id="expense-form">
      <input type="number" name="amount" placeholder="📤 مصروف شخصي (المبلغ)" required>
      
      <select name="category" id="category-select" onchange="togglecustomInput()" required style="width: 100%; padding: 10px; border: 1px solid #e0e0e0; border-radius: 6px; font-size: 0.95rem; background: #fafafa; text-align: center;">
        <option value="" disabled selected>🛒 اختر فئة المصروف</option>
        <option value="غذاء">🍔 أكل وشرب</option>
        <option value="نقل">🚌 مواصلات ونقل</option>
        <option value="إنترنت">📱 إنترنت ورصيد هاتف</option>
        <option value="ملابس">👕 ملابس ومشتريات</option>
        <option value="custom">✍️ كتابة فئة أخرى...</option> 
      </select>

      <input type="text" name="custom_category" id="custom-category-input" placeholder="اكتب هنا ماذا صرفت..." style="display: none; margin-top: 5px; border-color: #e67e22;">
      
      <button type="submit">📉 خصم مصروف</button>
    </form>
  </div>

  <script>
    function togglecustomInput() {
      const select = document.getElementById('category-select');
      const input = document.getElementById('custom-category-input');
      
      if (select.value === 'custom') {
        input.style.display = 'block'; 
        input.required = true;         
        input.focus();                 
      } else {
        input.style.display = 'none';  
        input.required = false;
      }
    }
  </script>

  <div style="background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-top: 25px; margin-bottom: 25px; text-align: right;" dir="rtl">
    <h3 style="color: #2c3e50; margin-top: 0; border-bottom: 2px solid #f1f2f6; padding-bottom: 10px;">🎯 حصالتي الرقمية وأهدافي</h3>
    
    <form action="/add-goal" method="POST" style="display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap;">
      <input type="text" name="title" placeholder="اسم الهدف (مثلاً: هاتف جديد)" required style="flex: 2; padding: 8px; border: 1px solid #ddd; border-radius: 6px;">
      <input type="number" name="targetAmount" placeholder="المبلغ المطلوب" required style="flex: 1; padding: 8px; border: 1px solid #ddd; border-radius: 6px;">
      <button type="submit" style="background: #27ae60; color: white; border: none; padding: 8px 15px; border-radius: 6px; cursor: pointer; font-weight: bold;">+ إضافة هدف</button>
    </form>

    <div style="display: flex; flex-direction: column; gap: 15px;">
      <% if (user.savingsGoals && user.savingsGoals.length > 0) { %>
        
        <h4 style="color: #2980b9; margin: 5px 0 0 0; font-size: 0.95rem;">⏳ الأهداف الحالية المتبقية:</h4>
        <% let activeGoalsCount = 0; %>
        <% user.savingsGoals.forEach(goal => { %>
          <% let percentage = Math.min(Math.round((goal.savedAmount / goal.targetAmount) * 100), 100); %>
          <% if (percentage < 100) { %>
            <% activeGoalsCount++; %>
            <div style="border: 1px solid #eee; padding: 15px; border-radius: 8px; background: #fbfbfb;">
              <div style="display: flex; justify-content: space-between; font-weight: bold; color: #34495e; margin-bottom: 8px;">
                <span>📱 <%= goal.title %></span>
                <span style="color: #2980b9;"><%= goal.savedAmount %> / <%= goal.targetAmount %> دج (<%= percentage %>%)</span>
              </div>

              <div style="width: 100%; background: #e0e0e0; height: 10px; border-radius: 6px; overflow: hidden; margin-bottom: 12px;">
                <div style="width: <%= percentage %>%; background: linear-gradient(90deg, #3498db, #2ecc71); height: 100%;"></div>
              </div>

              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <form action="/delete-goal/<%= goal._id %>" method="POST" onsubmit="return confirm('هل تريد كسر هذه الحصالة واسترجاع الأموال؟');" style="margin:0;">
                  <button type="submit" style="background-color: #e74c3c; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 0.8rem;">🔨 كسر واسترجاع</button>
                </form>

                <form action="/deposit-goal/<%= goal._id %>" method="POST" style="display: flex; gap: 5px; margin:0;">
                  <input type="number" name="depositAmount" placeholder="المبلغ" required style="width: 80px; padding: 4px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.85rem;">
                  <button type="submit" style="background: #3498db; color: white; border: none; padding: 4px 10px; border-radius: 4px; cursor: pointer; font-size: 0.85rem;">💰 إيداع</button>
                </form>
              </div>
            </div>
          <% } %>
        <% }) %>
        <% if (activeGoalsCount === 0) { %>
          <p style="color: #95a5a6; font-size: 0.85rem; padding-right: 10px;">لا توجد أهداف قيد التقدم حالياً.</p>
        <% } %>

        <hr style="border: 0; border-top: 1px dashed #ddd; margin: 15px 0;">

        <h4 style="color: #27ae60; margin: 0; font-size: 0.95rem;">🏆 الأهداف التي حققتها بنجاح (الأرشيف):</h4>
        <% let completedGoalsCount = 0; %>
        <% user.savingsGoals.forEach(goal => { %>
          <% let percentage = Math.min(Math.round((goal.savedAmount / goal.targetAmount) * 100), 100); %>
          <% if (percentage === 100) { %>
            <% completedGoalsCount++; %>
            <div style="border: 1px dashed #27ae60; padding: 8px 15px; border-radius: 6px; background: #f4fbf7; display: flex; justify-content: space-between; align-items: center; margin-top: 5px;">
              <span style="font-weight: bold; color: #27ae60;">🎉 <%= goal.title %></span>
              <div style="display: flex; align-items: center; gap: 15px;">
                <span style="color: #7f8c8d; font-size: 0.85rem; font-weight: bold;"><%= goal.targetAmount %> دج (مكتمل)</span>
                <form action="/delete-goal/<%= goal._id %>" method="POST" onsubmit="return confirm('هل تريد حذف هذا الهدف المحقق من الأرشيف نهائياً؟');" style="margin:0;">
                  <button type="submit" style="background: none; border: none; color: #95a5a6; cursor: pointer; font-size: 0.9rem;">🗑️</button>
                </form>
              </div>
            </div>
          <% } %>
        <% }) %>
        <% if (completedGoalsCount === 0) { %>
          <p style="color: #95a5a6; font-size: 0.85rem; padding-right: 10px;">لم تحقق أي هدف بعد.</p>
        <% } %>

      <% } else { %>
        <p style="color: #7f8c8d; font-size: 0.9rem; text-align: center; margin: 10px 0;">لا توجد أهداف ادخار حالياً، ابدأ بإضافة هدفك الأول فوق! 🚀</p>
      <% } %>
    </div>
  </div>

  <h3>📜 سجل المعاملات:</h3>
  <div class="filter-bar">
    <a href="/dashboard?type=all" class="filter-btn <%= filterType === 'all' ? 'active' : '' %>">الكل</a>
    <a href="/dashboard?type=income" class="filter-btn <%= filterType === 'income' ? 'active' : '' %>">💰 الدخل</a>
    <a href="/dashboard?type=loan" class="filter-btn <%= filterType === 'loan' ? 'active' : '' %>">💸 السُلف</a>
    <a href="/dashboard?type=personal" class="filter-btn <%= filterType === 'personal' ? 'active' : '' %>">📤 المصاريف</a>
  </div>

  <table>
    <tr>
      <th>النوع</th>
      <th>المبلغ</th>
      <th>إلى/الفئة</th>
      <th>التاريخ</th>
      <th>الإجراءات</th>
    </tr>
    <% filteredOperations.forEach(op => { %>
      <tr>
        <td>
         <% if (op.type === 'income') { %> 
            💰 دخل
          <% } else if (op.type === 'loan') { %> 
            💸 سُلف
          <% } else if (op.type === 'personal') { %> 
            🧾 مصروف (<%= op.category || 'أخرى' %>) <% } else { %> 
            - 
          <% } %>
        </td>
        <td><strong><%= op.amount %> دج</strong></td>
        <td><%= op.to || op.category || '-' %></td>
        <td><%= op.date.toLocaleDateString() %></td>
        <td>
          <form action="/delete-operation/<%= op._id %>" method="POST" style="display:inline;">
            <button type="submit">🗑</button>
          </form>
          <form action="/edit-operation/<%= op._id %>" method="GET" style="display:inline;">
            <button type="submit">✏</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>

  <a href="/logout" class="logout-btn" style="display: block; width: fit-content; margin: 20px auto; padding: 10px 20px; background: #95a5a6; color: white; text-decoration: none; border-radius: 5px;">🚪 تسجيل الخروج</a>

  <div id="balance-alert" class="crypto-toast">
  ⚠️ انتبه يا يونس، رصيدك الحالي انخفض تحت 2000 دج! خفف من المصاريف.
</div>

<script>
  // قراءة رصيدك الحالي من خلال الـ EJS وتمريره للجافاسكريبت
  const currentBalance = parseFloat("<%= user.balance %>");

  // التحقق مما إذا كان الرصيد أقل من 2000 دج
  if (currentBalance < 2000) {
    const alertBox = document.getElementById('balance-alert');
    
    // 1. إظهار التنبيه بعد ثانية واحدة من فتح الموقع بنعومة
    setTimeout(() => {
      alertBox.classList.add('show');
    }, 1000);

    // 2. إخفاء التنبيه تلقائياً بعد 5 ثوانٍ من ظهوره
    setTimeout(() => {
      alertBox.classList.remove('show');
    }, 6000);
  }
</script>
</body>
</html>