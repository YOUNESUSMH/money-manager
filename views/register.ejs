<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>إنشاء حساب جديد</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <div class="auth-container">
    <h1>✨ حساب جديد</h1>
    <p class="auth-subtitle">ابدأ بإدخال اسم مستخدم وكلمة سر قوية لإدارة ميزانيتك الخاصة بخصوصية وأمان.</p>

    <form action="/register" method="POST" class="auth-form">
      <div class="input-group">
        <label for="username">👤 اسم المستخدم الجديد:</label>
        <input type="text" id="username" name="username" placeholder="اختر اسم مستخدم" required>
      </div>

      <div class="input-group">
        <label for="password">🔒 كلمة السر:</label>
        <input type="password" id="password" name="password" placeholder="اختر كلمة سر قوية" required>
      </div>

      <button type="submit" class="login-submit-btn" style="background-color: #27ae60 !important;">تسجيل الحساب 🚀</button>
    </form>

    <div class="auth-footer">
      <span>لديك حساب بالفعل؟</span>
      <a href="/login">تسجيل الدخول من هنا</a>
    </div>
  </div>

</body>
</html>